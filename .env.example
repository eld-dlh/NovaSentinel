# NovaSentinel — Environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Django
SECRET_KEY=your-very-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Space-Track.org credentials (https://www.space-track.org/auth/createAccount)
SPACETRACK_IDENTITY=your-email@example.com
SPACETRACK_PASSWORD=your-spacetrack-password

# PostgreSQL (leave blank to use SQLite for local dev)
# Format: postgres://username:password@hostname:port/database_name
DATABASE_URL=postgres://novasentinel:novasentinel@localhost:5432/novasentinel

# AWS ElasticBeanstalk / S3 (only needed for production deployment)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1
